<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Ostinato 節奏大師 - 遊戲化升級版</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<style>
  /* 遊戲化糖果色系變數 */
  :root { 
    --bg-gradient: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
    --primary-color: #5758BB; 
    --text-color: #2f3542;
    --accent-red: #ff4757; 
    --accent-green: #2ed573;
    --accent-blue: #1e90ff;
    --accent-yellow: #ffa502;
    --box-bg: rgba(255, 255, 255, 0.9);
  }

  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@600;800;900&display=swap');

  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Nunito', 'Segoe UI', sans-serif; user-select: none; }
  body { background: var(--bg-gradient); color: var(--text-color); height: 100vh; display: flex; flex-direction: column; overflow: hidden; }

  /* 頂部導航列 */
  header { 
    background-color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; 
    box-shadow: 0 4px 15px rgba(0,0,0,0.05); z-index: 10; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;
    margin-bottom: 10px;
  }
  header h2 { color: var(--primary-color); font-weight: 900; font-size: 24px; letter-spacing: 1px;}
  .time-signature { font-size: 28px; font-weight: 900; color: var(--accent-red); background: #ffeaa7; padding: 5px 15px; border-radius: 15px; border: 2px solid #fdcb6e;}
  
  /* 立體遊戲按鈕共用樣式 */
  .btn {
    border: none; padding: 12px 20px; border-radius: 15px; font-size: 16px; font-weight: 800; cursor: pointer;
    transition: all 0.1s; position: relative; color: white;
  }
  .btn:active { transform: translateY(4px); box-shadow: 0 0px 0 transparent !important; }
  
  .btn-primary { background-color: var(--accent-yellow); box-shadow: 0 4px 0 #e15f41; color: #2f3542; }
  .btn-play { background-color: var(--accent-green); box-shadow: 0 4px 0 #218c53; }
  .btn-stop { background-color: var(--accent-red); box-shadow: 0 4px 0 #c0392b; }
  .btn-export { background-color: var(--accent-blue); box-shadow: 0 4px 0 #3742fa; }
  .btn-clear { background-color: #747d8c; box-shadow: 0 4px 0 #57606f; }

  /* 核心創作區 */
  main { flex: 1; display: flex; align-items: center; position: relative; padding: 10px;}
  .scroll-container { width: 100%; overflow-x: auto; padding: 30px 20px; -webkit-overflow-scrolling: touch; }
  .track { display: flex; width: max-content; gap: 20px; margin: 0 auto; transition: padding 0.3s; }
  
  /* 小節設計 (雲朵般的方塊) */
  .measure { 
    display: flex; height: 130px; padding: 8px; 
    border: 4px solid white; border-radius: 20px; 
    background-color: var(--box-bg); position: relative;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    background-image: linear-gradient(to right, transparent 96px, rgba(0,0,0,0.05) 96px);
    background-size: 100px 100%;
    transition: all 0.2s;
  }
  .measure::after { 
    content: attr(data-label); position: absolute; top: -30px; left: 10px; 
    font-size: 16px; font-weight: 800; color: white; background: var(--primary-color);
    padding: 2px 12px; border-radius: 10px; box-shadow: 0 3px 0 #30336b;
  }
  .measure.drag-over { background-color: #e0f7fa; border-color: var(--accent-blue); transform: scale(1.02); }
  .measure.error { background-color: #ffcccc; animation: shake 0.3s; border-color: var(--accent-red); }

  /* 放入小節內的音符 */
  .note-element { 
    height: 100%; cursor: pointer; display: flex; flex-direction: column; 
    align-items: center; justify-content: center; 
    border: 3px dashed transparent; transition: all 0.2s;
    background-color: white; border-radius: 12px; margin: 0 2px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  }
  .note-element:hover { border-color: var(--accent-red); background-color: #fff0f0; transform: translateY(-2px); }
  .note-element.playing { background-color: #fffacd; border-color: #f39c12; transform: scale(1.05) translateY(-5px); box-shadow: 0 10px 15px rgba(241, 196, 15, 0.4); z-index: 5; }
  .note-element img { max-width: 100%; max-height: 60px; object-fit: contain; pointer-events: none; }
  .note-element span { font-size: 14px; color: var(--primary-color); margin-top: 8px; font-weight: 900; text-align: center;}
  .fallback-text { font-size: 32px; display: none; } 

  /* 底部控制區與音符庫 */
  footer { background-color: white; z-index: 10; box-shadow: 0 -5px 20px rgba(0,0,0,0.05); border-top-left-radius: 25px; border-top-right-radius: 25px; padding-top: 15px;}
  .controls { display: flex; justify-content: center; flex-wrap: wrap; gap: 15px; padding: 10px 20px 0 20px; }
  
  .note-library { display: flex; overflow-x: auto; padding: 20px 20px 30px 20px; gap: 15px; justify-content: flex-start; }
  
  /* 音符卡片設計 */
  .library-card { 
    min-width: 95px; width: 95px; height: 120px; background-color: white; 
    border: 3px solid #dfe4ea; border-radius: 18px; cursor: grab; 
    box-shadow: 0 6px 0 #dfe4ea; flex-shrink: 0; transition: all 0.2s;
  }
  .library-card:hover { transform: translateY(-5px); box-shadow: 0 11px 0 #dfe4ea; border-color: var(--primary-color); }
  .library-card:active { transform: translateY(6px); box-shadow: 0 0px 0 #dfe4ea; }
  .library-card .note-element { width: 100%; height: 100%; background: none; border: none; box-shadow: none; margin: 0; }
  .library-card .note-element:hover { transform: none; background: none;}

  @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 50% { transform: translateX(5px); } 75% { transform: translateX(-5px); } }
</style>
</head>
<body>

  <header>
    <h2>🎵 Ostinato 節奏大師</h2>
    <div class="time-signature">🎯 <span id="sig-display">4/4</span> 拍</div>
    <button class="btn btn-primary" onclick="initGame()">🎲 重新抽題</button>
  </header>

  <main>
    <div class="scroll-container">
      <div class="track" id="track-container"></div>
    </div>
  </main>

  <footer>
    <div class="controls">
      <button class="btn btn-play" onclick="playRhythm()">▶️ 播放</button>
      <button class="btn btn-stop" onclick="stopRhythm()">⏹️ 停止</button>
      <button class="btn btn-clear" onclick="clearGrid()">🗑️ 清除</button>
      <button class="btn btn-export" onclick="exportImage()">📸 影相交功課</button>
    </div>
    <div style="text-align:center; padding-top: 15px; font-size: 14px; font-weight: 800; color: #a4b0be;">
      💡 將下方音符拖入小節。點擊方格內音符可刪除。
    </div>
    <div class="note-library" id="library-container"></div>
  </footer>

  <script>
    // 拍號設定
    const timeSignatures = [
      { id: '3/4', type: 'simple', beats: 3 },
      { id: '4/4', type: 'simple', beats: 4 },
      { id: '6/8', type: 'compound', beats: 2 }, 
      { id: '9/8', type: 'compound', beats: 3 }  
    ];

    // 音符數據
    const notesData = {
      simple: [
        { src: 'note_q.png', fallback: '♩', label: '1 拍', beats: 1, pattern: [0] },
        { src: 'note_qq.png', fallback: '♫', label: '1 拍', beats: 1, pattern: [0, 0.5] },
        { src: 'rest_q.png', fallback: '𝄽', label: '1 拍', beats: 1, pattern: [] },
        { src: 'note_h.png', fallback: '𝅗𝅥', label: '2 拍', beats: 2, pattern: [0] },
        { src: 'rest_h.png', fallback: '𝄼', label: '2 拍', beats: 2, pattern: [] },
        { src: 'note_w.png', fallback: '𝅝', label: '4 拍', beats: 4, pattern: [0] },
        { src: 'note_dq.png', fallback: '♩.', label: '1.5 拍', beats: 1.5, pattern: [0] },
        { src: 'note_e.png', fallback: '♪', label: '0.5 拍', beats: 0.5, pattern: [0] }
      ],
      compound: [
        { src: 'note_dq.png', fallback: '♩.', label: '1 大拍', beats: 1, pattern: [0] },
        { src: 'note_eee.png', fallback: '♫♪', label: '1 大拍', beats: 1, pattern: [0, 1/3, 2/3] },
        { src: 'rest_dq.png', fallback: '𝄽.', label: '1 大拍', beats: 1, pattern: [] },
        { src: 'note_q.png', fallback: '♩', label: '2/3 大拍', beats: 2/3, pattern: [0] },
        { src: 'note_e.png', fallback: '♪', label: '1/3 大拍', beats: 1/3, pattern: [0] },
        { src: 'rest_q.png', fallback: '𝄽', label: '2/3 大拍', beats: 2/3, pattern: [] }
      ]
    };

    let currentSig = null;
    let draggedData = null; 
    let audioCtx = null;
    let isPlaying = false;
    let playTimeouts = [];
    const pixelsPerBeat = 100; 

    function initGame() {
      stopRhythm();
      const randomIdx = Math.floor(Math.random() * timeSignatures.length);
      currentSig = timeSignatures[randomIdx];
      document.getElementById('sig-display').innerText = currentSig.id;
      renderGrid();
      renderLibrary();
    }

    function renderGrid() {
      const track = document.getElementById('track-container');
      track.innerHTML = '';
      const measureWidth = currentSig.beats * pixelsPerBeat; 

      for(let m = 1; m <= 4; m++) {
        const measure = document.createElement('div');
        measure.className = 'measure';
        measure.style.width = `${measureWidth}px`;
        measure.setAttribute('data-label', `第 ${m} 小節`);
        measure.dataset.capacity = currentSig.beats; 
        setupMeasureDropZone(measure);
        track.appendChild(measure);
      }
    }

    function renderLibrary() {
      const lib = document.getElementById('library-container');
      lib.innerHTML = '';
      const availableNotes = notesData[currentSig.type];
      
      availableNotes.forEach(note => {
        const card = document.createElement('div');
        card.className = 'library-card';
        card.setAttribute('draggable', 'true');
        
        const noteEl = document.createElement('div');
        noteEl.className = 'note-element';
        noteEl.innerHTML = `
          <img src="${note.src}" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
          <div class="fallback-text">${note.fallback}</div>
          <span>${note.label}</span>
        `;
        noteEl.dataset.beats = note.beats;
        noteEl.dataset.pattern = JSON.stringify(note.pattern);
        
        card.addEventListener('dragstart', (e) => { draggedData = noteEl.cloneNode(true); });
        card.appendChild(noteEl);
        lib.appendChild(card);
      });
    }

    function setupMeasureDropZone(measure) {
      measure.addEventListener('dragover', (e) => { e.preventDefault(); measure.classList.add('drag-over'); });
      measure.addEventListener('dragleave', () => measure.classList.remove('drag-over'));
      measure.addEventListener('drop', (e) => {
        e.preventDefault(); 
        measure.classList.remove('drag-over');
        if (!draggedData) return;

        let currentUsedBeats = 0;
        measure.querySelectorAll('.note-element').forEach(n => { currentUsedBeats += parseFloat(n.dataset.beats); });

        const newNoteBeats = parseFloat(draggedData.dataset.beats);
        const capacity = parseFloat(measure.dataset.capacity);

        if (currentUsedBeats + newNoteBeats > capacity + 0.01) { 
          measure.classList.add('error'); 
          setTimeout(() => measure.classList.remove('error'), 300);
          return;
        }

        const newNote = draggedData.cloneNode(true);
        newNote.style.width = `calc(${newNoteBeats * pixelsPerBeat}px - 4px)`; 
        newNote.title = "點擊移除";
        newNote.addEventListener('click', () => { if(!isPlaying) newNote.remove(); });
        measure.appendChild(newNote);
      });
    }

    function clearGrid() { if(!isPlaying) document.querySelectorAll('.measure').forEach(m => m.innerHTML = ''); }

    function initAudio() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
    }

    function playMarimba(time) {
      if(!audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine'; 
      osc.frequency.setValueAtTime(523.25, time); 
      gain.gain.setValueAtTime(0, time);
      gain.gain.linearRampToValueAtTime(0.8, time + 0.01);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.4);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(time);
      osc.stop(time + 0.5);
    }

    function playRhythm() {
      if (isPlaying) return;
      initAudio();
      isPlaying = true;
      const BPM = 85; 
      const beatDuration = 60 / BPM; 
      let startTime = audioCtx.currentTime + 0.2; 
      const measures = document.querySelectorAll('.measure');
      let currentBeatOffset = 0; 

      measures.forEach(measure => {
        const notes = measure.querySelectorAll('.note-element');
        notes.forEach(note => {
          const noteBeats = parseFloat(note.dataset.beats);
          const noteStartTime = startTime + (currentBeatOffset * beatDuration);
          const visualDelay = (noteStartTime - audioCtx.currentTime) * 1000;
          const visualDuration = (noteBeats * beatDuration * 1000) - 50;

          const t1 = setTimeout(() => { note.classList.add('playing'); }, visualDelay);
          const t2 = setTimeout(() => { note.classList.remove('playing'); }, visualDelay + visualDuration);
          playTimeouts.push(t1, t2);

          const pattern = JSON.parse(note.dataset.pattern);
          pattern.forEach(fraction => {
            const hitTime = noteStartTime + (fraction * noteBeats * beatDuration);
            playMarimba(hitTime);
          });

          currentBeatOffset += noteBeats;
        });
        let used = 0;
        notes.forEach(n => used += parseFloat(n.dataset.beats));
        currentBeatOffset += (parseFloat(measure.dataset.capacity) - used);
      });

      const totalDuration = (currentBeatOffset * beatDuration * 1000);
      const endTimer = setTimeout(() => { isPlaying = false; }, totalDuration + 200);
      playTimeouts.push(endTimer);
    }

    function stopRhythm() {
      isPlaying = false;
      playTimeouts.forEach(t => clearTimeout(t)); 
      playTimeouts = [];
      document.querySelectorAll('.note-element').forEach(n => n.classList.remove('playing'));
    }

    function exportImage() {
      const track = document.getElementById('track-container');
      // 美化截圖背景
      track.style.background = "linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%)";
      track.style.padding = "40px 20px 20px 20px"; 
      track.style.borderRadius = "20px";

      html2canvas(track).then(canvas => {
        track.style.background = "transparent";
        track.style.padding = "0";
        track.style.borderRadius = "0";
        const safeSigName = currentSig.id.replace('/', '-');
        const link = document.createElement('a');
        link.download = `Ostinato_${safeSigName}_功課.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    }

    window.onload = initGame;
  </script>
</body>
</html>
